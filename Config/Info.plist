<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Custom keys merged with the Xcode-generated Info.plist
	     (GENERATE_INFOPLIST_FILE stays YES). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>RS.LocalAIHelper.localmind</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>localmind</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle auto-updates: the feed is the appcast attached to the latest
	     GitHub release (a stable redirect URL). Update integrity: Developer ID
	     code-signing chain; add SUPublicEDKey here once you generate Sparkle
	     EdDSA keys (see docs/DISTRIBUTION.md) for signature validation too. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Dizzy918/LocalMind/releases/latest/download/appcast.xml</string>
	<!-- "Ask LocalMind" in the Services menu: select text in any app,
	     right-click → Services → Ask LocalMind. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask LocalMind</string>
			</dict>
			<key>NSMessage</key>
			<string>askLocalMind</string>
			<key>NSPortName</key>
			<string>LocalMind</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
